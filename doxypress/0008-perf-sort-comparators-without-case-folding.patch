From 6362673494ab6d0298f190b63591d57f235a0686 Mon Sep 17 00:00:00 2001
From: Niklas Hauser <niklas.hauser@rwth-aachen.de>
Date: Tue, 13 Oct 2026 10:17:14 +0200
Subject: [PATCH 08/12] perf: sort comparators without case folding

---
 src/classlist.cpp    |  7 ++++---
 src/index.cpp        |  7 ++++---
 src/memberlist.cpp   |  3 ++-
 src/membername.cpp   |  3 ++-
 src/namespacedef.cpp |  3 ++-
 src/sortedlist.cpp   | 23 ++++++++++++-----------
 src/stringmap.cpp    | 14 +++++++-------
 7 files changed, 33 insertions(+), 27 deletions(-)

diff --git a/src/classlist.cpp b/src/classlist.cpp
index a90ee39a..b532e89a 100644
--- a/src/classlist.cpp
+++ b/src/classlist.cpp
@@ -19,6 +19,7 @@
 *
 *************************************************************************/
 
+#include <stringmap.h>
 #include <classlist.h>
 
 #include <arguments.h>
@@ -34,13 +35,13 @@ static int compItems(const QSharedPointer<ClassDef> &c1, const QSharedPointer<Cl
    static const bool sortByScopeName = Config::getBool("sort-by-scope-name");
 
    if (sortByScopeName) {
-      return c1->name().compare(c2->name(), Qt::CaseInsensitive);
+      return StringCompare::compareNoCase(c1->name(), c2->name());
 
    } else {
-      int compareResult = c1->className().compare(c2->className(), Qt::CaseInsensitive);
+      int compareResult = StringCompare::compareNoCase(c1->className(), c2->className());
 
       if (compareResult == 0) {
-         return c1->name().compare(c2->name(), Qt::CaseInsensitive);
+         return StringCompare::compareNoCase(c1->name(), c2->name());
       } else {
          return compareResult;
       }
diff --git a/src/index.cpp b/src/index.cpp
index 3a0bcbef..cb36648c 100644
--- a/src/index.cpp
+++ b/src/index.cpp
@@ -19,6 +19,7 @@
 *
 *************************************************************************/
 
+#include <stringmap.h>
 #include <index.h>
 
 #include <config.h>
@@ -342,10 +343,10 @@ class MemberIndexList : public QList<QSharedPointer<MemberDef>>
    { }
 
    static bool compareValues(const QSharedPointer<MemberDef> md1, const QSharedPointer<MemberDef> md2) {
-      int result = md1->name().compare(md2->name(), Qt::CaseInsensitive);
+      int result = StringCompare::compareNoCase(md1->name(), md2->name());
 
       if (result == 0) {
-         result = md1->qualifiedName().compare(md2->qualifiedName(), Qt::CaseInsensitive);
+         result = StringCompare::compareNoCase(md1->qualifiedName(), md2->qualifiedName());
       }
 
       return result < 0;
@@ -1876,7 +1877,7 @@ class PrefixIgnoreClassList : public SortedList<QSharedPointer<ClassDef>>
       QString tmp1 = n1.mid( getPrefixIndex(n1) );
       QString tmp2 = n2.mid( getPrefixIndex(n2) );
 
-      int i = tmp1.compare(tmp2, Qt::CaseInsensitive);
+      int i = StringCompare::compareNoCase(tmp1, tmp2);
 
       return i < 0;
    }
